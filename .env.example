# Only environment variables are read. This file is a template, not auto-loaded.
# Set GLM_MODEL to a model actually enabled on your account; no model is assumed.
GLM_API_KEY=
GLM_MODEL=
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# Coding Plan use must match the provider's authorized scope.
# No live request without --live-model; no fallback to a different billing endpoint.
# The example always uses --dry-run and never starts a robot or TTS node.
